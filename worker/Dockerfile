# ---------- Worker: Notification service (RabbitMQ consumer) ----------
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY . .

USER node

# Worker không mở cổng HTTP: chỉ nhận tin từ RabbitMQ và ghi vào MongoDB
CMD ["node", "worker.js"]
