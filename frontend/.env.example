# Base URL của API mà trình duyệt gọi tới. Mặc định "/api" (cùng origin, đi qua proxy).
# Chỉ đặt khi muốn gọi thẳng backend, ví dụ: http://localhost:8080/api
VITE_API_URL=

# Địa chỉ backend mà Vite dev/preview server proxy /api tới (mặc định http://localhost:8080)
API_PROXY_TARGET=http://localhost:8080
